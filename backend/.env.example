# MongoDB connection string (e.g., MongoDB Atlas in production)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=dynamic_ai_chatbot

# JWT secret key for signing tokens
JWT_SECRET_KEY=replace_with_a_secure_random_key

# Ollama local/remote server configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=embeddinggemma

# Ollama gateway token for authentication
OLLAMA_GATEWAY_TOKEN=replace_with_a_secure_random_token

# Allowed CORS origins separated by commas (optional, defaults to localhost and *.vercel.app)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
